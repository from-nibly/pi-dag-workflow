{
  "name": "pi-dag-workflow",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi DAG workflow extension with project discovery, chunking, and ordered subagent flows.",
  "keywords": ["pi-package", "pi-extension", "dag-workflow"],
  "license": "MIT",
  "scripts": {
    "smoke": "node scripts/smoke-test.mjs",
    "test:model": "node scripts/project-model-test.mjs",
    "migrate:model": "node scripts/migrate-brainstorm-to-project-model.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "pi-subagents": "0.25.0"
  },
  "optionalDependencies": {
    "lavish-axi": "0.1.43"
  },
  "pi": {
    "extensions": [
      "./extensions/dag-workflow/index.ts"
    ]
  },
  "files": [
    "extensions/",
    "scripts/",
    "README.md",
    "LICENSE"
  ]
}
