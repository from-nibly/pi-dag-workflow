    "test:dag-evaluation": "node scripts/dag-evaluation-test.mjs",
    "test:dag-dogfood": "node scripts/dag-dogfood-test.mjs",
    "test:dag-dogfood-portfolio": "node scripts/dag-dogfood-portfolio.mjs",
    "test:git-integration": "node scripts/git-integration-test.mjs",
    "test:workers": "node scripts/worker-runtime-test.mjs",
    "migrate:model": "node scripts/migrate-brainstorm-to-project-model.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
