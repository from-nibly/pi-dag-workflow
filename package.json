{
  "name": "pi-dag-workflow",
  "version": "0.5.0",
  "type": "module",
  "description": "Pi extension for authoritative project modeling, inspectable DAG planning, and durable execution.",
  "keywords": ["pi-package", "pi-extension", "dag-workflow"],
  "license": "MIT",
  "scripts": {
    "smoke": "node scripts/smoke-test.mjs",
    "test:model": "node scripts/project-model-test.mjs",
    "test:dag-planning": "node scripts/dag-planning-test.mjs",
    "test:dag-planning-runtime": "node scripts/dag-planning-runtime-test.mjs",
    "test:dag-planning-command": "node scripts/dag-planning-command-test.mjs",
    "test:dag-prepared-start": "node scripts/dag-prepared-start-test.mjs",
    "test:dag-runtime": "node scripts/dag-runtime-test.mjs",
    "test:dag-v2-state": "node scripts/dag-v2-state-test.mjs",
    "test:dag-v2-lifecycle": "node scripts/dag-v2-lifecycle-test.mjs",
    "test:dag-v2-context": "node scripts/dag-v2-context-test.mjs",
    "test:dag-v2-historical-evaluation": "node scripts/dag-v2-historical-evaluation-test.mjs",
    "test:dag-v2-git-acceptance": "node scripts/dag-v2-git-acceptance-test.mjs",
    "test:dag-v2-git-attributes": "node scripts/dag-v2-git-attributes-test.mjs",
    "test:dag-v2-git-hooks": "node scripts/dag-v2-git-hooks-test.mjs",
    "test:dag-v2-workspace": "node scripts/dag-v2-workspace-test.mjs",
    "test:dag-v2-product": "node scripts/dag-v2-product-test.mjs",
    "test:dag-v2-git-characterization": "node scripts/dag-v2-git-test.mjs",
    "test:dag-widget": "node scripts/dag-widget-test.mjs",
    "test:dag-evaluation": "node scripts/dag-evaluation-test.mjs",
    "test:dag-dogfood": "node scripts/dag-dogfood-test.mjs",
    "test:dag-dogfood-portfolio": "node scripts/dag-dogfood-portfolio.mjs",
    "test:git-integration": "node scripts/git-integration-test.mjs",
    "test:workers": "node scripts/worker-runtime-test.mjs && node scripts/worker-activity-test.mjs",
    "test:worker-activity": "node scripts/worker-activity-test.mjs",
    "test:node-workspace-ownership": "node scripts/node-workspace-ownership-test.mjs",
    "test:release-impact": "node scripts/release-impact-test.mjs",
    "release:impact": "node scripts/release-impact.mjs",
    "release:ready": "node scripts/release-readiness.mjs",
    "release:full": "node scripts/release-readiness.mjs --full --no-cache",
    "migrate:model": "node scripts/migrate-brainstorm-to-project-model.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "optionalDependencies": {
    "lavish-axi": "0.1.43"
  },
  "pi": {
    "extensions": [
      "./extensions/dag-workflow/index.ts"
    ]
  },
  "files": [
    "extensions/",
    "scripts/",
    "project-model/",
    "spec/",
    "README.md",
    "LICENSE"
  ]
}
