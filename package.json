{
  "name": "pi-dag-workflow",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi extension for authoritative project modeling and durable asynchronous subagents.",
  "keywords": ["pi-package", "pi-extension", "dag-workflow"],
